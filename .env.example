# Copy to .env and fill in.

# Postgres connection. Examples:
#   postgresql://user:pass@localhost:5432/sots
#   host=/var/run/postgresql user=sots dbname=sots
DATABASE_URL=postgresql://user:pass@localhost:5432/sots

# OpenAI-compatible endpoint for the curator + dedup-judge LLMs.
# Defaults to OpenAI proper. Override to point at OpenRouter, a self-hosted
# proxy, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Models. Defaults below are OpenRouter slugs; swap for any chat-completion
# model your endpoint supports (e.g. gpt-4o, gpt-4o-mini, claude-3-5-sonnet,
# etc.).
SOT_EXTRACT_MODEL=anthropic/claude-sonnet-4.5
SOT_JUDGE_MODEL=anthropic/claude-haiku-4.5

# Optional: brand name to focus the extraction prompt. If set (e.g. "Acme"),
# the LLM will require HOW-TOS and PRODUCT INFO cards to be scoped to that
# brand's products — generic procedures and competitor mentions get filtered
# out. Leave blank for a brand-neutral prompt.
SOT_BRAND_NAME=

# GitHub repo that stores the knowledge base (markdown files).
# The PAT needs Contents: read and write on this repo.
SOT_GITHUB_REPO=yourname/your-sot-repo
SOT_GITHUB_PAT=ghp_xxx_or_github_pat_xxx

# Optional: also mirror the rebuilt index to a local markdown file.
# Leave blank to disable.
SOT_REFERENCE_PATH=

# Flask session secret. If unset, a random per-process key is generated.
FLASK_SECRET_KEY=

# Bind host (default 127.0.0.1 — loopback only). Set to 0.0.0.0 to expose,
# but only with auth enabled (see below) or SOT_ALLOW_OPEN=1.
SOT_HOST=127.0.0.1
PORT=5000
SOT_MAX_UPLOAD_BYTES=12582912  # 12 MB total request body

# Werkzeug debug mode — NEVER enable on a public host. Gives interactive RCE.
FLASK_DEBUG=0

# ── Authentication ──────────────────────────────────────────────────────────────
# Mode: 'none' | 'basic' | 'token'.
#   none  — no auth. Allowed only on loopback (SOT_HOST=127.0.0.1) or with
#           SOT_ALLOW_OPEN=1. The app refuses to start otherwise.
#   basic — HTTP Basic auth; set SOT_AUTH_USER + SOT_AUTH_PASSWORD.
#   token — require header `X-Auth-Token: <SOT_AUTH_TOKEN>` (or ?token=...).
SOT_AUTH_MODE=none
SOT_AUTH_USER=
SOT_AUTH_PASSWORD=
SOT_AUTH_TOKEN=
# Set to 1 to allow SOT_AUTH_MODE=none on a non-loopback host. You almost
# certainly do not want this.
SOT_ALLOW_OPEN=0
